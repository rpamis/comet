-    });
-    const checkReceiptRef = await writeNativeCheckReceipt({
-      paths,
-      name: verifyState.name,
-      receipt,
-    });
-    return (
-      await persistNativeStaticInspectionReceipt({
-        paths,
-        state: verifyState,
-        checkReceipt: receipt,
-        checkReceiptRef,
-      })

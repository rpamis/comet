-    ...exclusions,
-    ...['changes', 'archive'].map(
-      (directory) => `:(exclude,glob)${prefix}comet/${directory}/*/walkthrough.html`,
-    ),
-    ...['changes', 'archive'].flatMap((directory) =>
-      [...NATIVE_RUNTIME_MANAGED_FILES].map(

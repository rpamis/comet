-  };
-  const isGeneratedDirectory = (name: string): boolean =>
-    NATIVE_GENERATED_INPUT_DIRECTORIES.includes(
-      name as (typeof NATIVE_GENERATED_INPUT_DIRECTORIES)[number],
-    );

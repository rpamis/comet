-async function nativeIgnoredCheckInputSnapshot(
-  projectRoot: string,
-  plans: readonly NativeCheckPlan[],
-  managedArtifactRoot?: string,
-  runnerInputs: ReadonlySet<string> = new Set(),
-  stagedIndex = '',

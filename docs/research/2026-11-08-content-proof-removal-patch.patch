-    return true;
-  if (
-    NATIVE_WORKTREE_INPUT_DIRECTORIES.has(normalized.split('/')[0]) ||
-    normalized === '.comet/current-change.json' ||
-    normalized === '.comet/runtime' ||
-    normalized.startsWith('.comet/runtime/')

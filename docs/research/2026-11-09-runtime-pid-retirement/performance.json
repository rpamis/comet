  "driver": "import fs from 'node:fs';\nimport path from 'node:path';\nimport {spawnSync} from 'node:child_process';\nimport {fileURLToPath} from 'node:url';\nconst base=path.dirname(fileURLToPath(import.meta.url));\nconst records=[];\nconst config='schema: comet.project.v1\\ndefault_workflow: classic\\nworkflows:\\n  - classic\\nclassic:\\n  artifact_layout: legacy\\n  language: en\\n  context_compression: off\\n  review_mode: standard\\n  auto_transition: true\\n';\nfunction invoke(variant,kind,root,env,args,operation){\n const log=path.join(path.dirname(root),'git-trace.json');fs.writeFileSync(log,'');\n const start=performance.now();const c=spawnSync(process.execPath,[path.join(base,variant+'-'+kind+'.mjs'),...args],{cwd:root,env:{...env,GIT_TRACE2_EVENT:log},encoding:'utf8',windowsHide:true,timeout:120000,maxBuffer:8*1024*1024});const ms=performance.now()-start;\n let json;try{json=JSON.parse(c.stdout);}catch{throw new Error('Bad JSON '+c.stdout+' '+c.stderr);}\n if(c.status!==0||json.exitCode!==0)throw new Error(JSON.stringify({variant,kind,args,status:c.status,stdout:c.stdout,stderr:c.stderr}));\n const gitCalls=fs.readFileSync(log,'utf8').split('\\n').filter(Boolean).map(x=>JSON.parse(x)).filter(x=>x.event==='start').length;\n return {ms,gitCalls,reused:json.data?.reused===true};\n}\nfor(const count of [0,2000])for(let round=0;round<3;round++)for(const variant of round%2?['after','before']:['before','after'])for(const kind of ['native','classic']){\n const fixture=path.join(base,'measured-runs',count+'-'+round+'-'+variant+'-'+kind);const root=path.join(fixture,'project');fs.mkdirSync(root,{recursive:true});fs.mkdirSync(path.join(root,'src'));\n for(let i=0;i<count;i++)fs.writeFileSync(path.join(root,'src','file-'+i+'.txt'),'line '+i+'\\n'+'x'.repeat(1024));\n const git=spawnSync('git',['init','-q','-b','benchmark'],{cwd:root,encoding:'utf8'});if(git.status)throw new Error(git.stderr);\n const env={...process.env,COMET_DATA_DIR:path.join(fixture,'runtime'),COMET_DAEMON:'off',COMET_SKIP_UPDATE_CHECK:'1',COMET_FORCE_PHASE:'1'};\n if(kind==='native'){\n  for(const op of ['new','status']){\n   const args=[op,'bench','--project-root',root,'--json',...[]];\n   records.push({variant,kind,count,round,operation:op,...invoke(variant,kind,root,env,args,op)});\n  }\n }else{\n  fs.mkdirSync(path.join(root,'.comet'));fs.writeFileSync(path.join(root,'.comet/config.yaml'),config);fs.mkdirSync(path.join(root,'openspec/changes/archive'),{recursive:true});fs.mkdirSync(path.join(root,'openspec/specs'),{recursive:true});fs.writeFileSync(path.join(root,'openspec/config.yaml'),'schema: spec-driven\\n');\n  invoke(variant,kind,root,env,['state','init','bench','tweak','--runtime','compat','--json']);\n  invoke(variant,kind,root,env,['state','set','bench','build_mode','direct','tdd_mode','direct','verify_mode','light','isolation','current','phase','build','--json']);\n  for(const op of ['first-check','repeat-check']){\n   const args=['check','run','bench','build','--local','--json','--',process.execPath,'-e','process.stdout.write(\"ok\")'];\n   records.push({variant,kind,count,round,operation:op,...invoke(variant,kind,root,env,args,op)});\n  }\n }\n fs.writeFileSync(path.join(base,'results.json'),JSON.stringify({baseline:'7f016b28',node:process.version,platform:process.platform,records},null,2)+'\\n');\n console.log('Finished',variant,kind,count,'round',round+1);\n}\nconst rows=[];for(const count of [0,2000])for(const kind of ['native','classic'])for(const operation of kind==='native'?['new','status']:['first-check','repeat-check']){\n const row={count,kind,operation};for(const variant of ['before','after']){const group=records.filter(x=>x.count===count&&x.kind===kind&&x.operation===operation&&x.variant===variant);const sorted=group.map(x=>x.ms).sort((a,b)=>a-b);row[variant]={medianMs:Math.round(sorted[1]),minMs:Math.round(sorted[0]),maxMs:Math.round(sorted.at(-1)),gitCalls:group.map(x=>x.gitCalls),reused:group.map(x=>x.reused)};}rows.push(row);\n}fs.writeFileSync(path.join(base,'summary.json'),JSON.stringify(rows,null,2)+'\\n');console.log(JSON.stringify(rows,null,2));\n"
}

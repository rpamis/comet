-      const hashes = [
-        raw,
-        ...['sha1', 'sha256'].map(
-          (algorithm) =>
-            `git:${createHash(algorithm).update(`blob ${bytes.length}\0`).update(bytes).digest('hex')}`,
-        ),
-      ];
-      if (raw === receipt.contentHash && hashes.includes(entry.afterHash))

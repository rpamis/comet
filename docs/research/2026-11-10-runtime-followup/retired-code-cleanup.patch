-  const changes = [...diff.added, ...diff.removed, ...diff.changed].map((ref) => ({
-    path: ref,
-    beforeHash: old.get(ref) ?? 'missing',
-    afterHash: current.get(ref) ?? 'missing',
-  }));
-  // 回到 Build 后旧报告留作历史；只排除同一 Run 真正验收且字节未变的 Runtime 输出。
-  if (run && state.phase === 'build') {

@@ -0,0 +1,499 @@
+import { hashRuntimeValue, type WorkflowRun, type RuntimeAction } from '../engine/runtime.js';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+import { readProtectedProjectFile } from '../workflow-contract/protected-project-path.js';
+import { resolveWorkspaceRuntimeRoot } from '../workflow-contract/workspace-runtime.js';
+import {
+  nativeRawInputSnapshot,
+  saveNativeRawInput,
+  readNativeRawInput,
+  nativeRawInputChanges,
+} from './native-portable-checks.js';
+import { parseNativePortableState } from './native-portable-state.js';
+import { nativeSdkCheckRuntimeRef } from './native-sdk-check-execution.js';
+import { nativeProjectPaths } from './native-paths.js';
+import { nativeVerifyMode } from './native-verification-policy.js';
+import {
+  assertNativeSdkCandidateUnchanged,
+  nativeSdkCurrentCheckSummaries,
+  NativeSdkCandidateDriftError,
+  NativeSdkCheckInputDriftError,
+  NativeSdkCheckInputSnapshotError,
+} from './native-sdk-checks.js';
+
+export async function prepareNativeVerificationBaseline(
+  projectRoot: string,
+  artifactRootRef: string,
+  name: string,
+) {
+  const paths = await nativeProjectPaths(projectRoot, artifactRootRef);
+  const snapshot = await nativeRawInputSnapshot({
+    projectRoot,
+    managedArtifactRoot: paths.artifactRoot,
+  });
+  if (!snapshot.complete)
+    throw new Error(
+      `Native verification baseline is incomplete: ${snapshot.diagnostics.join('; ')}`,
+    );
+  const directory = `native/verification-baselines/${hashRuntimeValue(name)}`;
+  const ref = await saveNativeRawInput(paths.workspaceRuntimeRoot, directory, snapshot);
+  return { directory, ref, contentHash: snapshot.contentHash };
+}
+
+/** 只为已领取任务读取当前材料；正文不进入 Run 或状态查询，也不代替最终输入核对。 */
+export async function nativeVerifierReviewInput(
+  context: NonNullable<Awaited<ReturnType<typeof nativeVerifierContext>>>,
+  reviewerSessionId?: string,
+) {
+  const text = (zh: string, en: string) => (context.language === 'zh-CN' ? zh : en);
+  const files: Array<{
+    root: string;
+    path: string;
+    kind: 'text' | 'binary' | 'deleted' | 'repository' | 'generated';
+    mode?: string;
+    contentHash?: string;
+    content?: string;
+  }> = [];
+  const diagnostics: string[] = [];
+  const changes = context.changeRefs as {
+    complete: boolean;
+    fullChanges?: Array<{ path: string; afterHash: string; afterMode: string }>;
+    incrementalChanges?: Array<{ path: string; afterHash: string; afterMode: string }>;
+    generatedPaths?: string[];
+  };
+  const incremental =
+    context.session.strategy === 'resume' &&
+    context.session.sessionId === reviewerSessionId &&
+    Array.isArray(changes.incrementalChanges);
+  const result = () => ({
+    status: diagnostics.length ? ('incomplete' as const) : ('complete' as const),
+    candidateId: context.candidateId,
+    currentInputHash: context.checkInput.currentHash,
+    scope: incremental ? ('incremental' as const) : ('full' as const),
+    originalRequest: context.originalRequest,
+    acceptance: context.acceptance,
+    checkInput: context.checkInput,
+    checkEvidence: context.checkEvidence,
+    ...(incremental && context.previousReview ? { previousReview: context.previousReview } : {}),
+    instruction: context.instruction,
+    files,
+    diagnostics,
+  });
+  if (!changes.complete || context.checkInput.candidateStatus !== 'unchanged') {
+    diagnostics.push(
+      context.checkInput.reason ??
+        text('当前候选的输入尚未准备完整。', 'Current candidate inputs are unavailable.'),
+    );
+    return result();
+  }
+  const sources = new Map<
+    string,
+    { root: string; path: string; expectedHash?: string; mode?: string; generated?: boolean }
+  >();
+  for (const ref of context.requirementRefs) {
+    const root = context.workspace.projectRoot;
+    sources.set(`${root}\0${ref}`, { root, path: ref });
+  }
+  const generated = new Set(changes.generatedPaths ?? []);
+  for (const change of (incremental ? changes.incrementalChanges : changes.fullChanges) ?? []) {
+    const root = context.workspace.implementationRoot;
+    sources.set(`${root}\0${change.path}`, {
+      root,
+      path: change.path,
+      expectedHash: change.afterHash,
+      mode: change.afterMode,
+      generated: generated.has(change.path),
+    });
+  }
+  // 正文交付也须保留目录规则；只读取根到目标目录实际存在的 AGENTS.md。
+  const inspectedRules = new Set<string>();
+  for (const source of [...sources.values()]) {
+    const directories = source.path.split('/').slice(0, -1);
+    for (let depth = 0; depth <= directories.length; depth += 1) {
+      const ref = [...directories.slice(0, depth), 'AGENTS.md'].join('/');
+      const key = `${source.root}\0${ref}`;
+      if (sources.has(key) || inspectedRules.has(key)) continue;
+      inspectedRules.add(key);
+      try {
+        await fs.lstat(path.join(source.root, ref));
+        sources.set(key, { root: source.root, path: ref });
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code !== 'ENOENT')
+          diagnostics.push(`${ref}: ${error instanceof Error ? error.message : String(error)}`);
+      }
+    }
+  }
+  const ordered = [...sources.values()].sort((a, b) => {
+    const rule = (ref: string) => path.posix.basename(ref) === 'AGENTS.md';
+    return (
+      Number(rule(b.path)) - Number(rule(a.path)) ||
+      (rule(a.path) && rule(b.path) ? a.path.split('/').length - b.path.split('/').length : 0)
+    );
+  });
+  for (const source of ordered) {
+    const identity = { root: source.root, path: source.path };
+    try {
+      if (source.expectedHash === 'missing') {
+        try {
+          await fs.lstat(path.join(source.root, source.path));
+          diagnostics.push(
+            text(
+              `已删除的验收输入重新出现：${source.path}`,
+              `Deleted review input exists again: ${source.path}`,
+            ),
+          );
+        } catch (error) {
+          if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+          files.push({ ...identity, kind: 'deleted' });
+        }
+        continue;
+      }
+      if (source.mode === '160000') {
+        files.push({ ...identity, kind: 'repository', mode: source.mode });
+        continue;
+      }
+      if (source.generated) {
+        files.push({
+          ...identity,
+          kind: 'generated',
+          mode: source.mode,
+          contentHash: source.expectedHash,
+        });
+        continue;
+      }
+      const read = await readProtectedProjectFile(
+        source.root,
+        source.path,
+        Number.MAX_SAFE_INTEGER,
+        {
+          label: text('Native 验收材料', 'Native Verifier input'),
+        },
+      );
+      const contentHash = createHash('sha256').update(read.bytes).digest('hex');
+      if (source.expectedHash && contentHash !== source.expectedHash) {
+        diagnostics.push(
+          text(
+            `验收输入在候选观察后发生变化：${source.path}`,
+            `Review input changed after candidate observation: ${source.path}`,
+          ),
+        );
+        continue;
+      }
+      const mode =
+        process.platform === 'win32' || !(Number(read.stat.mode) & 0o111) ? '100644' : '100755';
+      if (source.mode && mode !== source.mode) {
+        diagnostics.push(
+          text(
+            `验收输入的执行权限在候选观察后发生变化：${source.path}`,
+            `Review input permissions changed after candidate observation: ${source.path}`,
+          ),
+        );
+        continue;
+      }
+      let content: string;
+      try {
+        content = new TextDecoder('utf-8', { fatal: true, ignoreBOM: true }).decode(read.bytes);
+        if (content.includes('\0')) throw new Error('Binary input');
+      } catch {
+        files.push({ ...identity, kind: 'binary', contentHash, mode });
+        continue;
+      }
+      files.push({ ...identity, kind: 'text', contentHash, content, mode });
+    } catch (error) {
+      diagnostics.push(`${source.path}: ${error instanceof Error ? error.message : String(error)}`);
+    }
+  }
+  return result();
+}
+
+export async function readNativeVerificationBaseline(
+  run: Readonly<WorkflowRun>,
+  projectRoot: string,
+) {
+  const baseline = (
+    run.input as { verificationBaseline?: { directory: string; ref: string; contentHash: string } }
+  ).verificationBaseline;
+  if (
+    !baseline ||
+    baseline.directory !== `native/verification-baselines/${hashRuntimeValue(run.runId)}`
+  )
+    throw new Error('Native verification baseline belongs to another Run or is missing');
+  const root = await resolveWorkspaceRuntimeRoot(projectRoot);
+  const snapshot = await readNativeRawInput(root, baseline.directory, baseline.ref);
+  if (!snapshot.complete || snapshot.contentHash !== baseline.contentHash)
+    throw new Error('Native verification baseline is incomplete or changed');
+  return snapshot;
+}
+
+const builders = new Set([
+  'build.builder',
+  'supervisor.parent.builder',
+  'supervisor.child.builder',
+  'supervisor.child.integration-repair',
+]);
+
+export async function nativeVerifierSession(
+  run: Readonly<WorkflowRun>,
+  action: Readonly<RuntimeAction>,
+  projectRoot: string,
+) {
+  const index = run.actions.findIndex((entry) => entry.id === action.id);
+  const shapeIndex = run.actions
+    .slice(0, index)
+    .map((entry) => entry.stepId === 'shape.revalidate' && entry.status === 'succeeded')
+    .lastIndexOf(true);
+  const prior = run.actions
+    .slice(Math.max(0, shapeIndex + 1), index)
+    .reverse()
+    .find((entry) => entry.stepId === 'verify.verifier');
+  const output = prior?.outcome?.output as
+    { candidateId?: string; response?: { kind?: string } } | undefined;
+  const candidateId = parseNativePortableState(run.state).builder_handoff?.candidate_id;
+  const sessionId = prior?.claim?.sessionId;
+  if (
+    prior?.status !== 'succeeded' ||
+    !sessionId ||
+    !output ||
+    (output.candidateId === candidateId && output.response?.kind !== 'request-checks') ||
+    run.actions.some((entry) => builders.has(entry.stepId) && entry.claim?.sessionId === sessionId)
+  ) {
+    return { strategy: 'fresh' as const };
+  }
+  const checks = run.actions.filter(
+    (entry) => ['verify.checks', 'verify.requested-checks'].includes(entry.stepId) && entry.outcome,
+  );
+  const refFor = (id: string | undefined) =>
+    (
+      [...checks]
+        .reverse()
+        .find((entry) => (entry.outcome!.output as { candidateId?: string }).candidateId === id)
+        ?.outcome?.output as { rawInput?: { afterRef: string } } | undefined
+    )?.rawInput?.afterRef;
+  const previousRef = refFor(output.candidateId);
+  const currentRef = refFor(candidateId);
+  if (!previousRef || !currentRef) return { strategy: 'fresh' as const };
+  if (previousRef !== currentRef) {
+    const root = await resolveWorkspaceRuntimeRoot(projectRoot);
+    const directory = `${nativeSdkCheckRuntimeRef(run)}/inputs`;
+    const [previous, current] = await Promise.all([
+      readNativeRawInput(root, directory, previousRef),
+      readNativeRawInput(root, directory, currentRef),
+    ]);
+    if (!previous.complete || !current.complete)
+      throw new Error('Native verification input is incomplete');
+    if (previous.projectRoot !== current.projectRoot) return { strategy: 'fresh' as const };
+  }
+  return { strategy: 'resume' as const, sessionId, previousActionId: prior.id };
+}
+
+/** 提供真实来源和增量范围；不把 Builder 自评或累积 Action 输入交给审查者。 */
+export async function nativeVerifierContext(
+  run: Readonly<WorkflowRun>,
+  action: Readonly<RuntimeAction>,
+  projectRoot: string,
+) {
+  if (nativeVerifyMode(run) !== 'bugfree' || action.stepId !== 'verify.verifier') return undefined;
+  const state = parseNativePortableState(run.state);
+  const input = run.input as {
+    artifactRootRef: string;
+    verificationBaseline?: { directory: string; ref: string; contentHash: string };
+  };
+  const root = await resolveWorkspaceRuntimeRoot(projectRoot);
+  const plans = run.actions.filter(

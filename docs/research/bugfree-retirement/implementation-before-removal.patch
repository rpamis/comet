+      verdict,
+      evidence: {
+        summary: 'Independently checked Child',
+        checks: ['candidate-process'],
+        acceptance: [
+          {
+            id: 'A1',
+            result: verdict === 'pass' ? 'passed' : 'failed',
+            reason: 'Actual artifact checked',

@@ -0,0 +1,153 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { checkFrozenProjectAtBoundary } from './native-bugfree-oracle.js';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+
+export interface FrozenBugfreeCase {
+  id: string;
+  requirements: string;
+  expectedVerdict: string;
+  boundary?: 'browser' | 'supervisor';
+  bootstrap?: string;
+  baselineFiles?: Record<string, string>;
+  baselineFileHashes?: Record<string, string>;
+  files: Record<string, string>;
+  fileHashes: Record<string, string>;
+  oracle: string;
+  oracleSha256: string;
+}
+
+export interface FrozenBugfreeFlow {
+  bootstrap?: string;
+  id: string;
+  kind: string;
+  requirements: string;
+  initialFiles: Record<string, string>;
+  initialFileHashes: Record<string, string>;
+  referenceFiles: Record<string, string>;
+  referenceFileHashes: Record<string, string>;
+  oracle: string;
+  oracleSha256: string;
+}
+
+export interface FrozenBugfreeDataset {
+  cases: FrozenBugfreeCase[];
+  flows: FrozenBugfreeFlow[];
+}
+
+const digest = (text: string) => createHash('sha256').update(text).digest('hex');
+
+export function assertFrozenBugfreeFiles(
+  files: Record<string, string>,
+  hashes: Record<string, string>,
+) {
+  assert.deepEqual(Object.keys(files).sort(), Object.keys(hashes).sort());
+  for (const [file, text] of Object.entries(files)) assert.equal(digest(text), hashes[file], file);
+}
+
+/** 只运行仓库内冻结的判定代码；不调用 Agent、模型、容器或外部依赖。 */
+export async function checkFrozenBugfreeProject(
+  files: Record<string, string>,
+  oracle: string,
+  boundary?: 'browser' | 'supervisor',
+  requirements = '',
+  baselineFiles?: Record<string, string>,
+) {
+  return checkFrozenProjectAtBoundary(files, oracle, boundary, requirements, baselineFiles);
+}
+
+/** 隐藏标签、判定代码和参考修复均不写入参与评估的工作区。 */
+export async function assembleFrozenBugfreeTasks(root: string, dataset: FrozenBugfreeDataset) {
+  const skill = path.join(root, 'skill');
+  await fs.mkdir(path.join(skill, 'comet'), { recursive: true });
+  await fs.cp('assets/skills/comet-native', path.join(skill, 'comet-native'), { recursive: true });
+  await fs.mkdir(path.join(skill, 'comet'), { recursive: true });
+  await fs.cp('assets/skills/comet/reference', path.join(skill, 'comet/reference'), {
+    recursive: true,
+  });
+  await fs.writeFile(
+    path.join(skill, 'SKILL.md'),
+    '---\nname: comet-native\ndescription: Native workflow comparison fixture using the unchanged packaged Native Skill.\n---\n# Native comparison\nRead and follow [the packaged Native workflow](comet-native/SKILL.md). Its original references and Runtime assets are included. Use the assigned mode and the current Runtime task package.\n',
+  );
+  const tasks = [];
+  const inputs = [
+    ...dataset.cases.map((entry) => ({
+      id: entry.id,
+      requirements: entry.requirements,
+      files: entry.files,
+      fixed: true,
+      bootstrap: entry.bootstrap,
+    })),
+    ...dataset.flows.map((entry) => ({
+      id: entry.id,
+      requirements: entry.requirements,
+      files: entry.initialFiles,
+      fixed: false,
+      bootstrap: entry.bootstrap,
+    })),
+  ];
+  for (const input of inputs) {
+    const workspace = `cases/${input.id}`;
+    await fs.mkdir(path.join(skill, workspace), { recursive: true });
+    for (const [file, text] of Object.entries(input.files))
+      await fs.writeFile(path.join(skill, workspace, file), text);
+    tasks.push({
+      name: input.id,
+      workspace,
+      prompt: `${input.requirements}\n${input.fixed ? 'Review the fixed candidate without changing its implementation.' : 'Implement the requirement through the complete Native workflow.'}\n${input.bootstrap ? `Controller preparation: invoke ${input.bootstrap} in the selected worker before assigning the model task, retaining the returned control project and integration workspace. Never copy a different machine's Run or fabricate Child receipts.\n` : ''}Use the assigned standard or bugfree mode. Write result.json with schema comet.bugfree-result.v1, caseId, verdict, runId, candidateId and the actual verification report reference. User decisions in this benchmark are simulated and must be labelled as such.`,
+      expect: {
+        files: ['result.json'],
+        json: [{ file: 'result.json', path: '$.schema', equals: 'comet.bugfree-result.v1' }],
+      },
+    });
+  }
+  const manifest = path.join(skill, 'comet', 'eval.yaml');
+  await fs.writeFile(
+    manifest,
+    JSON.stringify(
+      {
+        apiVersion: 'comet.eval/v1alpha1',
+        kind: 'SkillEvalManifest',
+        metadata: { name: 'native-bugfree-frozen-052' },
+        skill: { name: 'comet-native', source: '..' },
+        evaluation: { tasks },
+      },
+      null,
+      2,
+    ),
+  );
+  return { skill, manifest, tasks };
+}
+
+/** 字段沿用 Eval 的真实事件统计；缺失值保留 null，不估算 token。 */
+export function frozenBugfreeMetrics(
+  events: Record<string, unknown>,
+  timing: { verifyActiveMs?: number; allIterationVerifyMs?: number; baselineCaptureMs?: number },
+) {
+  const number = (value: unknown) =>
+    typeof value === 'number' && Number.isFinite(value) ? value : null;
+  return {
+    verifyActiveMs: number(timing.verifyActiveMs),
+    allIterationVerifyMs: number(timing.allIterationVerifyMs),
+    baselineCaptureMs: number(timing.baselineCaptureMs),
+    inputTokens: number(events.input_tokens),
+    outputTokens: number(events.output_tokens),
+    totalTokens: number(events.total_tokens),
+    reasoningTokens: number(events.reasoning_tokens),
+    cachedReadTokens: number(events.cache_read_input_tokens),
+    cachedWriteTokens: number(events.cache_creation_input_tokens),
+    cost: number(events.total_cost_usd),
+  };
+}
+
+export function scoreFrozenBugfreeVerdict(
+  expected: string,
+  result: { verdict: string; completed: boolean },
+) {
+  return {
+    correct: result.completed && result.verdict === expected,
+    falseNegative: result.completed && expected === 'fail' && result.verdict === 'pass',
+    falsePositive: result.completed && expected === 'pass' && result.verdict === 'fail',
+  };
+}
diff --git a/test/helpers/native-bugfree-oracle.ts b/test/helpers/native-bugfree-oracle.ts
new file mode 100644
index 00000000..89142d93
--- /dev/null
+++ b/test/helpers/native-bugfree-oracle.ts
@@ -0,0 +1,158 @@
+import { promises as fs, existsSync } from 'node:fs';
+import path from 'node:path';
+import os from 'node:os';
+import assert from 'node:assert/strict';
+import { execFile, spawnSync } from 'node:child_process';
+import { promisify } from 'node:util';
+import { createServer, type ServerResponse } from 'node:http';
+import type { AddressInfo } from 'node:net';
+
+/** 普通确定性判定：实际文件/进程、浏览器或 SDK；不启动模型或容器。 */
+export async function checkFrozenProjectAtBoundary(
+  files: Record<string, string>,
+  oracle: string,
+  boundary?: 'browser' | 'supervisor',
+  requirements = '',
+  baselineFiles?: Record<string, string>,
+) {
+  const temporary = await fs.mkdtemp(path.join(os.tmpdir(), 'comet-frozen-oracle-'));
+  let root = path.join(temporary, 'project');
+  try {
+    if (boundary === 'supervisor') {
+      const { prepareFrozenSupervisorCandidate } = await import('./native-bugfree-supervisor.js');
+      const prepared = await prepareFrozenSupervisorCandidate(
+        temporary,
+        files,
+        requirements,
+        baselineFiles,
+      );
+      root = prepared.integrationRoot;
+      assert.equal(
+        prepared.run.actions.filter(
+          (action) => action.stepId === 'supervisor.child.checks' && action.status === 'succeeded',
+        ).length,
+        2,
+      );
+      assert.equal(
+        prepared.run.actions.filter(
+          (action) =>
+            action.stepId === 'supervisor.child.integrate' && action.status === 'succeeded',
+        ).length,
+        2,
+      );
+      assert.equal(prepared.context?.verifyMode, 'bugfree');
+      assert.equal(prepared.context?.workspace.implementationRoot, root);
+      // 隐藏判定使用字节相同的副本，避免测试数据写入使已绑定的父级候选失效。
+      root = path.join(temporary, 'oracle-project');
+      await fs.mkdir(root);
+      for (const [ref, text] of Object.entries(files))
+        await fs.writeFile(path.join(root, ref), text);
+    } else {
+      await fs.mkdir(root);
+      for (const [ref, text] of Object.entries(files))
+        await fs.writeFile(path.join(root, ref), text);
+    }
+    if (boundary === 'browser') return await checkBrowser(root, temporary, oracle);
+    const hidden = path.join(temporary, 'hidden-oracle.cjs');
+    await fs.writeFile(
+      hidden,
+      `const fs=require('node:fs'),path=require('node:path'),assert=require('node:assert/strict');const {execFileSync,spawnSync}=require('node:child_process');const root=process.argv[2];const candidate=require(path.join(root,'candidate.cjs'));(async()=>{${oracle}})().catch(error=>{process.stderr.write(String(error));process.exitCode=1});`,
+    );
+    const result = spawnSync(process.execPath, [hidden, root], {
+      encoding: 'utf8',
+      windowsHide: true,
+      timeout: 10000,
+    });
+    if (result.error) throw result.error;
+    if (result.status !== 0 && result.status !== 1)
+      throw new Error(`Hidden oracle execution failed: ${result.status}`);
+    return result.status === 0 ? 'pass' : 'fail';
+  } finally {
+    await fs.rm(temporary, { recursive: true, force: true });
+  }
+}
+
+async function checkBrowser(root: string, temporary: string, oracle: string) {
+  const browser = [
+    process.env.COMET_TEST_CHROME,
+    'C:/Program Files/Google/Chrome/Application/chrome.exe',
+    'C:/Program Files (x86)/Google/Chrome/Application/chrome.exe',
+    'C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe',
+    '/usr/bin/chromium',
+    '/usr/bin/google-chrome',
+    '/usr/bin/chromium-browser',
+    '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
+  ].find((file) => file && existsSync(file));
+  if (!browser)
+    throw new Error(
+      'A real Chrome/Edge browser is required for frozen UI truth; no model Eval was started',
+    );
+  let count = 0;
+  const pending: ServerResponse[] = [];
+  const server = createServer(async (request, response) => {
+    if (request.url === '/tick') {
+      setTimeout(() => response.end('tick'), 30);
+      return;
+    }
+    if (request.url === '/submit') {
+      count++;
+      pending.push(response);
+      return;
+    }
+    if (request.url === '/state') {
+      response.end(String(count));
+      return;
+    }
+    if (request.url === '/release') {
+      for (const waiting of pending.splice(0)) waiting.end('ok');
+      response.end('released');
+      return;
+    }
+    if (request.url === '/') {
+      response.setHeader('Content-Type', 'text/html');
+      response.end(
+        (await fs.readFile(path.join(root, 'index.html'), 'utf8')).replace(
+          '</body>',
+          `<script>${oracle}</script></body>`,
+        ),
+      );
+      return;
+    }
+    if (request.url === '/browser.js') {
+      response.setHeader('Content-Type', 'application/javascript');
+      response.end(await fs.readFile(path.join(root, 'browser.js')));
+      return;
+    }
+    response.statusCode = 404;
+    response.end();
+  });
+  await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve));
+  try {
+    const address = server.address() as AddressInfo;
+    const result = await promisify(execFile)(
+      browser,
+      [
+        '--headless=new',
+        '--disable-gpu',
+        '--disable-extensions',
+        '--disable-background-networking',
+        '--disable-component-update',
+        '--disable-sync',
+        '--no-first-run',
+        '--no-default-browser-check',
+        '--no-proxy-server',
+        `--user-data-dir=${path.join(temporary, 'browser-profile')}`,
+        '--dump-dom',
+        '--virtual-time-budget=5000',
+        `http://127.0.0.1:${address.port}/`,
+      ],
+      { encoding: 'utf8', windowsHide: true, timeout: 20000, maxBuffer: 2 * 1024 * 1024 },
+    );
+    const verdict = /<pre id="oracle-result" data-verdict="(pass|fail)"/u.exec(result.stdout)?.[1];
+    if (!verdict) throw new Error('Browser did not produce a complete hidden verdict');
+    return verdict;
+  } finally {
+    server.closeAllConnections();
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+  }
+}
diff --git a/test/helpers/native-bugfree-supervisor.ts b/test/helpers/native-bugfree-supervisor.ts
new file mode 100644
index 00000000..0ae95fa3
--- /dev/null
+++ b/test/helpers/native-bugfree-supervisor.ts
@@ -0,0 +1,150 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { execFileSync } from 'node:child_process';
+import { prepareNativeApplication } from './native-application.js';
+import type { RuntimeAction, WorkflowRun } from '../../domains/engine/runtime.js';
+import { nativeVerifierContext } from '../../domains/comet-native/native-verifier-context.js';
+import { fixtureAcceptanceReview } from './native-builder-acceptance-review.js';
+
+/** 用真实 SDK、Git worktree 和检查执行生成父级候选；Agent/User 身份均为明确标注的模拟。 */
+export async function prepareFrozenSupervisorCandidate(
+  root: string,
+  files: Record<string, string>,
+  requirements: string,
+  baselineFiles: Record<string, string> = files,
+  verifyMode: 'standard' | 'bugfree' = 'bugfree',
+) {
+  const f = await prepareNativeApplication(
+    root,
+    true,
+    'native',
+    process.env.COMET_NATIVE_TEST_PACKAGE_ROOT ?? path.resolve('.'),
+    verifyMode,
+    {
+      files: baselineFiles,
+      requirements,
+    },
+  );
+  f.git(f.projectRoot, ['config', '--local', 'user.name', 'Frozen fixture']);
+  f.git(f.projectRoot, ['config', '--local', 'user.email', 'fixture@example.invalid']);
+  const localCheck = `const fs=require('node:fs'),os=require('node:os'),path=require('node:path'),assert=require('node:assert/strict');const root=fs.mkdtempSync(path.join(os.tmpdir(),'comet-child-store-'));try{const system=require('./candidate.cjs')(root);const left=system.left(),right=system.right();assert.notEqual(left.id,right.id);assert.equal(system.read(left.id).id,left.id);assert.equal(system.read(right.id).id,right.id);}finally{fs.rmSync(root,{recursive:true,force:true});}`;
+  f.checks[0].argv = ['-e', localCheck];
+  let run: WorkflowRun = f.run;
+  for (let turn = 0; turn < 40; turn++) {
+    const verifier = f.pending(run, 'verify.verifier');
+    if (verifier) {
+      const context = await nativeVerifierContext(run, verifier, f.projectRoot);
+      const parent = [...run.actions]
+        .reverse()
+        .find((action) => action.stepId === 'supervisor.parent.builder')!;
+      const integrationRoot = (parent.input as { activation: { integrationWorktree: string } })
+        .activation.integrationWorktree;
+      for (const [ref, text] of Object.entries(files))
+        if ((await fs.readFile(path.join(integrationRoot, ref), 'utf8')) !== text)
+          throw new Error(`Frozen source changed: ${ref}`);
+      return {
+        run,
+        context,
+        integrationRoot,
+        projectRoot: f.projectRoot,
+        simulatedIdentities: true,
+        task: (await f.native(['status', f.name])).pendingActions.find(
+          (entry: { stepId: string }) => entry.stepId === 'verify.verifier',
+        ),
+      };
+    }
+    const action = f.pending(run) as RuntimeAction | undefined;
+    if (!action)
+      throw new Error('Frozen Supervisor has no runnable Action before final verification');
+    if (
+      action.stepId === 'supervisor.child.builder' ||
+      action.stepId === 'supervisor.parent.builder'
+    ) {
+      const activation = (
+        action.input as { activation: { worktree?: string; integrationWorktree?: string } }
+      ).activation;
+      const cwd = activation.worktree ?? activation.integrationWorktree!;
+      if (action.stepId === 'supervisor.parent.builder') {
+        for (const [ref, text] of Object.entries(files))
+          await fs.writeFile(path.join(cwd, ref), text);
+        f.git(cwd, ['add', ...Object.keys(files)]);
+        f.git(cwd, ['commit', '--allow-empty', '-m', 'Freeze the final parent candidate']);
+        run = await f.claim(action, `simulated-${action.id}-builder`);
+        const claimed = run.actions.find((entry) => entry.id === action.id)!;
+        run = await f.record(claimed, {
+          summary:
+            'Fixed parent candidate supplied for independent review; no parent command results are claimed.',
+          candidateCommit: f.git(cwd, ['rev-parse', 'HEAD']),
+          addressedAcceptanceIds: ['A1'],
+          acceptanceReview: fixtureAcceptanceReview(['A1']),
+          checks: [],
+          knownLimits: [
+            'Simulated fixture Builder; independent hidden truth is not given to the reviewer.',
+          ],
+          verificationChecks:
+            verifyMode === 'bugfree'
+              ? []
+              : [
+                  {
+                    id: 'parent-syntax',
+                    name: 'Parent module syntax',
+                    executable: process.execPath,
+                    argv: ['--check', 'candidate.cjs'],
+                    cwdRef: '.',
+                    timeoutMs: 10000,
+                    repeatable: true,
+                  },
+                ],
+          submittedAt: new Date().toISOString(),
+        });
+      } else {
+        execFileSync(process.execPath, ['-e', localCheck], {
+          cwd,
+          windowsHide: true,
+          stdio: 'pipe',
+        });
+        run = await f.submitBuilder(action, 'approved\n', `simulated-${action.id}-builder`);
+      }
+    } else if (action.stepId === 'supervisor.child.verifier') {
+      run = await f.claim(action, `simulated-${action.id}-verifier`);
+      const claimed = run.actions.find((entry) => entry.id === action.id)!;
+      const activation = (claimed.input as { activation: { candidateCommit: string } }).activation;
+      run = await f.record(claimed, {
+        candidateCommit: activation.candidateCommit,
+        verdict: 'pass',
+        evidence: {
+          summary:
+            'Simulated fixture Verifier: real shared-store checks passed before the final parent change.',
+          checks: ['candidate-process'],
+          acceptance: [
+            {
+              id: 'A1',
+              result: 'passed',
+              reason:
+                'Both routes have distinct persisted identifiers in this Child candidate; later parent changes need separate review.',
+            },
+          ],
+        },
+        integrationChecks: f.checks,
+      });
+    } else {
+      const executor =
+        action.stepId === 'supervisor.prepare'
+          ? 'native-supervisor-prepare'
+          : action.stepId === 'supervisor.child.prepare'
+            ? 'native-supervisor-child-prepare'
+            : action.stepId === 'supervisor.child.integrate'
+              ? 'native-supervisor-integrate'
+              : action.stepId === 'supervisor.child.archive'
+                ? 'native-supervisor-child-archive'
+                : 'comet-native-checks';
+      run = await f.dispatch({
+        operation: 'execute',
+        runId: f.name,
+        actionId: action.id,
+        executorId: executor,
+      });
+    }
+  }
+  throw new Error('Frozen Supervisor did not reach final verification');
+}
diff --git a/test/helpers/native-bugfree.ts b/test/helpers/native-bugfree.ts
new file mode 100644
index 00000000..ac4807ce
--- /dev/null
+++ b/test/helpers/native-bugfree.ts
@@ -0,0 +1,203 @@
+import { execFileSync, spawnSync } from 'node:child_process';
+import { promises as fs } from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { runNativeCli } from '../../domains/comet-native/native-cli.js';
+import { loadOwnedNativeSdkRuntime } from '../../domains/comet-native/native-runtime-ownership.js';
+import {
+  defaultProjectConfig,
+  writeProjectConfig,
+} from '../../domains/comet-native/native-config.js';
+import { fixtureAcceptanceReview } from './native-builder-acceptance-review.js';
+import type { RuntimeValue } from '../../domains/engine/runtime.js';
+
+export async function bugfreeFixture(
+  onRoot?: (root: string) => void,
+  cliPath?: string,
+  task?: string,
+  mode: 'standard' | 'bugfree' = 'bugfree',
+  initialFiles: Record<string, string> = {},
+) {
+  const temporary = await fs.mkdtemp(path.join(os.tmpdir(), 'comet-bugfree-'));
+  onRoot?.(temporary);
+  const root = path.join(temporary, 'project');
+  await fs.mkdir(root);
+  let requestIndex = 0;
+  const cli = (args: string[]) => {
+    const execution = spawnSync(process.execPath, [cliPath!, ...args], {
+      encoding: 'utf8',
+      windowsHide: true,
+    });
+    if (execution.status !== 0) throw new Error(execution.stdout + execution.stderr);
+    return JSON.parse(execution.stdout.slice(execution.stdout.indexOf('{')));
+  };
+  const dispatch = async (request: Record<string, unknown>) => {
+    const file = path.join(temporary, `request-${++requestIndex}.json`);
+    await fs.writeFile(file, JSON.stringify(request));
+    const result = cli([
+      'runtime',
+      'dispatch',
+      '--application',
+      'native',
+      '--project-root',
+      root,
+      '--request',
+      file,
+      '--json',
+    ]);
+    if (result.status !== 'succeeded') throw new Error(JSON.stringify(result));
+    return result.data;
+  };
+  const load = async () => {
+    const owned = await loadOwnedNativeSdkRuntime(root, 'bugfree-test');
+    return { ...owned, run: await owned.runtime.inspect('bugfree-test') };
+  };
+  const git = (...args: string[]) =>
+    execFileSync('git', ['-C', root, ...args], { windowsHide: true, stdio: 'pipe' });
+  git('init');
+  await fs.writeFile(path.join(root, 'value.txt'), 'initial\n');
+  for (const [ref, content] of Object.entries(initialFiles)) {
+    await fs.mkdir(path.dirname(path.join(root, ref)), { recursive: true });
+    await fs.writeFile(path.join(root, ref), content);
+  }
+  git('add', 'value.txt', ...Object.keys(initialFiles));
+  git(
+    '-c',
+    'user.name=Fixture',
+    '-c',
+    'user.email=fixture@example.invalid',
+    'commit',
+    '-m',
+    'initial',
+  );
+  const config = defaultProjectConfig('docs', 'zh-CN');
+  config.native.verify_mode = mode;
+  await writeProjectConfig(root, config);
+  const invoke = async (...args: string[]) => {
+    if (cliPath) {
+      const result = cli(['native', ...args, '--project-root', root, '--json']) as Awaited<
+        ReturnType<typeof runNativeCli>
+      >;
+      if (result.exitCode !== 0) throw new Error(JSON.stringify(result));
+      return result;
+    }
+    const result = await runNativeCli([...args, '--project-root', root, '--json']);
+    if (result.exitCode !== 0) throw new Error(JSON.stringify(result));
+    return result;
+  };
+  await invoke('new', 'bugfree-test', '--isolation', 'current', ...(task ? ['--task', task] : []));
+  const change = path.join(root, 'docs/comet/changes/bugfree-test');
+  await fs.writeFile(
+    path.join(change, 'brief.md'),
+    '# Outcome\nDeliver the expected value.\n# Scope\nChange the value.\n## Directory structure\n### Modified\n- value.txt — expected value.\n# Non-goals\nNo unrelated changes.\n# Acceptance examples\n- The value is expected.\n',
+  );
+  await fs.mkdir(path.join(change, 'specs/value'), { recursive: true });
+  await fs.writeFile(
+    path.join(change, 'specs/value/spec.md'),
+    '# Value\nThe final value is expected.\n',
+  );
+  await invoke('next', 'bugfree-test');
+  let owned = await load();
+  const state = owned.run.state as { state_version: number };
+  await invoke(
+    'next',
+    'bugfree-test',
+    '--confirmed',
+    '--summary',
+    'Approve fixture shape',
+    '--expected-state-version',
+    String(state.state_version),
+    '--expected-action',
+    'confirm-shape',
+  );
+  const submit = async (output: RuntimeValue, sessionId: string) => {
+    if (cliPath) {
+      const run = await dispatch({ operation: 'inspect', runId: 'bugfree-test' });
+      const action = run.actions.at(-1)!;
+      const claimToken =
+        action.claim?.sessionId === sessionId ? action.claim.token : crypto.randomUUID();
+      if (action.claim?.sessionId !== sessionId)
+        await dispatch({
+          operation: 'claim',
+          runId: run.runId,
+          actionId: action.id,
+          attempt: action.attempt,
+          inputHash: action.inputHash,
+          executorId: 'native-host',
+          sessionId,
+          claimToken,
+        });
+      await dispatch({
+        operation: 'record-outcome',
+        runId: run.runId,
+        outcome: {
+          actionId: action.id,
+          attempt: action.attempt,
+          inputHash: action.inputHash,
+          claimToken,
+          outcomeId: crypto.randomUUID(),
+          status: 'succeeded',
+          output,
+        },
+      });
+      return dispatch({ operation: 'inspect', runId: run.runId });
+    }
+    owned = await load();
+    const action = owned.run.actions.at(-1)!;
+    const context = { projectRoot: root, requestId: crypto.randomUUID() };
+    const claimed =
+      action.claim?.sessionId === sessionId
+        ? owned.run
+        : await owned.runtime.claim({
+            runId: owned.run.runId,
+            actionId: action.id,
+            attempt: action.attempt,
+            inputHash: action.inputHash,
+            executorId: 'native-host',
+            sessionId,
+            claimToken: crypto.randomUUID(),
+            context,
+          });
+    return owned.runtime.recordOutcome({
+      runId: owned.run.runId,
+      outcome: {
+        actionId: action.id,
+        attempt: action.attempt,
+        inputHash: action.inputHash,
+        claimToken: claimed.actions.at(-1)!.claim!.token,
+        outcomeId: crypto.randomUUID(),
+        status: 'succeeded',
+        output,
+      },
+      context,
+    });
+  };
+  const candidate = async (
+    value: string,

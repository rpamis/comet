# Required for `comet eval --suite langfuse` run mode.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=ci

# Claude Code and Codex official integrations are enabled by the suite through
# TRACE_TO_LANGFUSE=true. Install their official plugins in the agent image or
# project configuration before a run; collect mode never installs or contacts them.

#!/usr/bin/env bash
# SessionStart hook for comet auto-pilot
# Detects active comet changes and injects auto-resume context.

set -euo pipefail

# ── Platform detection ──────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

detect_platform() {
  if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
    echo "cursor"
  elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
    echo "claude"
  elif [ -n "${CODEX_PLUGIN_ROOT:-}" ]; then
    echo "codex"
  elif [ -n "${COPILOT_CLI:-}" ]; then
    echo "copilot"
  elif [ -n "${GEMINI_EXTENSION_ROOT:-}" ]; then
    echo "gemini"
  elif [ -n "${OPENCODE_PLUGIN_ROOT:-}" ]; then
    echo "opencode"
  else
    echo "unknown"
  fi
}

# ── JSON escaping ────────────────────────────────────────────────────
escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\f'/\\f}"
  s="${s//$'\b'/\\b}"
  # Strip other control characters (U+0000-U+001F) not already handled
  s=$(printf '%s' "$s" | LC_ALL=C tr -d '\000-\010\013\016-\037')
  printf '%s' "$s"
}

# ── Config loading ──────────────────────────────────────────────────
load_auto_config() {
  local project_dir="${1:-.}"
  local config_file="${project_dir}/comet-auto.yaml"
  local enabled="true"

  if [ -f "$config_file" ]; then
    local val
    val=$(grep -E '^[^#]*enabled:' "$config_file" 2>/dev/null | head -1 | awk '{print $2}' || echo "true")
    if [ "$val" = "false" ]; then
      enabled="false"
    fi
  fi
  echo "$enabled"
}

# ── Active change scanning ──────────────────────────────────────────
scan_active_changes() {
  local changes_json
  changes_json=$(openspec list --json 2>/dev/null || echo "[]")
  echo "$changes_json"
}

# ── Cycle prevention ────────────────────────────────────────────────
check_cycle_guard() {
  local active_file="$1"
  if [ -f "$active_file" ]; then
    return 0
  fi
  return 1
}

# ── Build injectable context ────────────────────────────────────────
build_context() {
  local project_dir="${1:-.}"
  local auto_enabled="$2"
  local changes_json="$3"

  local change_count
  change_count=$(echo "$changes_json" | python3 -c "import json,sys; d=json.load(sys.stdin); print(len(d))" 2>/dev/null || echo "0")

  if [ "$change_count" -eq 0 ]; then
    return 0
  fi

  local orphans=""
  local managed=""
  while IFS= read -r name; do
    if [ -f "${project_dir}/openspec/changes/${name}/.comet.yaml" ]; then
      managed="${managed}${name}\n"
    else
      orphans="${orphans}${name}\n"
    fi
  done < <(echo "$changes_json" | python3 -c "import json,sys; [print(c.get('name','')) for c in json.load(sys.stdin)]" 2>/dev/null)

  local context=""
  if [ "$auto_enabled" = "false" ]; then
    context="<comet-reminder>\n你有 ${change_count} 个未完成的 Comet change。输入 /comet 查看并续接。\n</comet-reminder>"
  else
    context="<comet-auto-resume>\n检测到 ${change_count} 个活跃 Comet change。"

    if [ -n "$managed" ]; then
      local first_change
      first_change=$(echo -e "$managed" | head -1 | tr -d '[:space:]')
      context="${context}\n正在自动续接 change: ${first_change}"
      context="${context}\n请立即使用 Skill 工具加载 comet-auto 技能，参数: change=${first_change}"
    fi

    if [ -n "$orphans" ]; then
      context="${context}\n\n发现孤儿 change（无 .comet.yaml，未纳入 Comet 管理）：${orphans}"
      context="${context}\n提示用户是否用 comet 采纳。"
    fi

    context="${context}\n</comet-auto-resume>"
  fi

  echo "$context"
}

# ── Main ────────────────────────────────────────────────────────────
main() {
  local project_dir="."

  # Check cycle guard — skip if auto-pilot already active for a change
  local active_marker="${project_dir}/openspec/changes/.comet-auto-active"
  if check_cycle_guard "$active_marker"; then
    exit 0
  fi

  local auto_enabled
  auto_enabled=$(load_auto_config "$project_dir")

  local changes_json
  changes_json=$(scan_active_changes)

  if [ "$changes_json" = "[]" ]; then
    exit 0
  fi

  local context
  context=$(build_context "$project_dir" "$auto_enabled" "$changes_json")

  if [ -z "$context" ]; then
    exit 0
  fi

  local context_escaped
  context_escaped=$(escape_for_json "$context")

  local platform
  platform=$(detect_platform)

  case "$platform" in
    cursor)
      printf '{\n  "additional_context": "%s"\n}\n' "$context_escaped"
      ;;
    claude|codex)
      printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$context_escaped"
      ;;
    *)
      printf '{\n  "additionalContext": "%s"\n}\n' "$context_escaped"
      ;;
  esac
}

main "$@"
exit 0
